# Master administrator password (required to access privileged workspace & settings)
ADMIN_PASSWORD=

# Optional collaborator/friend password for restricted user-level access
FRIEND_PASSWORD=

# Google Gemini API key for autonomous task orchestration & reasoning
GEMINI_API_KEY=

# Primary Gemini model identifier (default: gemini-3.8-flash)
GEMINI_PRIMARY_MODEL=

# AI provider identifier (default: gemini)
AI_PROVIDER=gemini

# Model override or fallback model identifier (optional)
AI_MODEL=

# Optional machine authorization token for headless CI/CD inspection
WORKSPACE_AUTH_TOKEN=

# Express server listening port (default: 3000)
PORT=3000

# Express server network interface binding (default: 0.0.0.0)
HOST=0.0.0.0

# Runtime environment mode (development | production | test)
NODE_ENV=development
